{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-miniature-timelapse.dev/schema/source-revision.schema.json",
  "title": "SourceRevision",
  "type": "object",
  "required": ["algorithm", "included_fields", "excluded_fields", "hash"],
  "properties": {
    "algorithm": {
      "const": "sha256",
      "description": "Hash algorithm used"
    },
    "included_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of field names/paths included in the hash (per Section 14.1)"
    },
    "excluded_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of field names/paths explicitly excluded (transient fields)"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Computed hash value"
    },
    "canonical_json": {
      "type": "string",
      "description": "The canonical JSON string that was hashed (sorted keys, no whitespace, NFC normalized)"
    }
  },
  "additionalProperties": false
}