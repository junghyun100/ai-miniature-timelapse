{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-miniature-timelapse.dev/schema/provenance.schema.json",
  "title": "Provenance",
  "type": "object",
  "required": ["source", "provider", "model_id", "base_url_label", "generated_at", "request_id", "source_revision"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["local_planner", "nim", "fallback"],
      "description": "Source of the prompt generation"
    },
    "provider": {
      "type": "string",
      "description": "Provider name (e.g., 'NVIDIA', 'local')"
    },
    "model_id": {
      "type": "string",
      "description": "Model identifier used"
    },
    "base_url_label": {
      "type": "string",
      "description": "Human-readable label for the API endpoint (no secrets)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of generation"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Corresponding NIM request ID"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Source revision at time of generation"
    },
    "fallback_scene_ids": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "description": "Scene IDs that fell back to local planner"
    },
    "validation_warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-fatal validation warnings"
    }
  },
  "additionalProperties": false
}