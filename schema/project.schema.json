{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MiniatureTimelapseProject",
  "type": "object",
  "required": ["topic", "duration", "format", "style", "scenes"],
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "duration": { "type": "integer", "enum": [30, 60] },
    "format": { "type": "string", "enum": ["9:16", "16:9"] },
    "style": { "type": "string", "minLength": 1 },
    "variant": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "seconds", "prompt", "negative_prompt"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "seconds": { "type": "integer", "minimum": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "negative_prompt": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

