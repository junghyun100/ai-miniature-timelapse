{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-miniature-timelapse.dev/schema/nim-response.schema.json",
  "title": "NIMResponse",
  "type": "object",
  "required": ["schema_version", "request_id", "source_revision", "scenes"],
  "properties": {
    "schema_version": {
      "const": "2.0",
      "description": "NIM contract schema version (must match request)"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Must match request.request_id exactly"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Must match request.source_revision exactly (staleness detection)"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "first_frame_prompt", "video_prompt"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "first_frame_prompt": {
            "type": "string",
            "description": "NIM-rewritten first frame prompt (empty string for scenes 2+ in relay mode)"
          },
          "video_prompt": {
            "type": "string",
            "minLength": 1,
            "description": "NIM-rewritten video prompt (never empty)"
          }
        },
        "additionalProperties": false
      },
      "description": "Refined prompts for each scene. Scene 2+ first_frame_prompt may be empty in relay mode."
    }
  },
  "additionalProperties": false
}